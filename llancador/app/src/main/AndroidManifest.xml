<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Per trucar directament als contactes permesos. -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-feature
        android:name="android.hardware.telephony"
        android:required="false" />

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Llancador">

        <!-- Pantalla principal. És també la pantalla d'inici del mòbil (HOME). -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Pantalla Telèfon: llista de contactes permesos. -->
        <activity
            android:name=".ContactesActivity"
            android:exported="false" />

        <!-- Filtre de trucades entrants: penja les que no són de contactes permesos. -->
        <service
            android:name=".FiltreTrucades"
            android:exported="true"
            android:permission="android.permission.BIND_SCREENING_SERVICE">
            <intent-filter>
                <action android:name="android.telecom.CallScreeningService" />
            </intent-filter>
        </service>

        <!-- Control de trucades sortints: només als contactes disponibles (el 112 sempre). -->
        <service
            android:name=".ControlTrucadesSortints"
            android:exported="true"
            android:permission="android.permission.BIND_CALL_REDIRECTION_SERVICE">
            <intent-filter>
                <action android:name="android.telecom.CallRedirectionService" />
            </intent-filter>
        </service>

        <!-- Botó 112 del panell de dalt. -->
        <service
            android:name=".Tile112"
            android:exported="true"
            android:icon="@drawable/ic_emergencia"
            android:label="@string/tile_112"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Diàleg «Vols trucar al 112?». Surt també amb el mòbil bloquejat. -->
        <activity
            android:name=".EmergenciaActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:showWhenLocked="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Llancador.Transparent" />

        <!-- Com funciona el meu mòbil: normes explicades al nen. -->
        <activity
            android:name=".ComFuncionaActivity"
            android:exported="false" />

        <!-- Receptor d'administrador: el que fa que l'app pugui ser Device Owner. -->
        <receiver
            android:name=".AdministradorDispositiu"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/administrador_dispositiu" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
