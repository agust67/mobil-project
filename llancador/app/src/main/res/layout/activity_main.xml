<?xml version="1.0" encoding="utf-8"?>
<!-- Pantalla d'inici: fons de color, hora i data, apps permeses, 112 i «Com funciona». -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fons_proves"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="24dp"
        android:paddingBottom="12dp">

        <TextClock
            android:id="@+id/hora"
            style="@style/TextSobreFons"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="32dp"
            android:fontFamily="sans-serif-light"
            android:format12Hour="HH:mm"
            android:format24Hour="HH:mm"
            android:textSize="80sp" />

        <TextClock
            android:id="@+id/data"
            style="@style/TextSobreFons"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:format12Hour="EEEE d MMMM"
            android:format24Hour="EEEE d MMMM"
            android:textSize="20sp" />

        <!-- Només surt al mode nit. -->
        <TextView
            android:id="@+id/text_mode_nit"
            style="@style/TextSobreFons"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:background="@drawable/fons_avis_nit"
            android:paddingHorizontal="16dp"
            android:paddingVertical="6dp"
            android:textSize="16sp"
            android:visibility="gone"
            tools:text="Mode nit fins a les 07:00"
            tools:visibility="visible" />

        <!-- Espai buit perquè les apps quedin a baix, a l'abast del polze. -->
        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Apps permeses: el codi hi afegeix files de 4 caselles (element_app). -->
        <LinearLayout
            android:id="@+id/graella_apps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <!-- Botó d'emergència: separat de les apps perquè no es premi sense voler. -->
        <TextView
            android:id="@+id/boto_112"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="20dp"
            android:background="@drawable/fons_boto_112"
            android:clickable="true"
            android:focusable="true"
            android:paddingHorizontal="20dp"
            android:paddingVertical="8dp"
            android:text="@string/boto_112"
            android:textColor="@android:color/white"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/enllac_com_funciona"
            style="@style/TextSobreFons"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:background="?attr/selectableItemBackground"
            android:padding="6dp"
            android:text="@string/enllac_com_funciona"
            android:textSize="13sp" />

        <!-- Només en versions de desenvolupament (ho decideix el codi). -->
        <LinearLayout
            android:id="@+id/grup_proves"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:id="@+id/text_estat"
                style="@style/TextSobreFons"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textSize="11sp"
                tools:text="Proves: mòbil gestionat · filtre actiu · sortints actiu" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/boto_mode_nit"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/boto_mode_nit_forcar"
                    android:textColor="@android:color/white"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/boto_treure_propietari"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/boto_treure_propietari"
                    android:textColor="@android:color/white"
                    android:textSize="12sp"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
