<?xml version="1.0" encoding="utf-8"?>
<!-- Pantalla d'inici: fons de color, hora i data, i la graella d'apps. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fons_proves"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="24dp">

        <TextClock
            android:id="@+id/hora"
            style="@style/TextSobreFons"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="32dp"
            android:format12Hour="HH:mm"
            android:format24Hour="HH:mm"
            android:textSize="80sp"
            android:fontFamily="sans-serif-light" />

        <TextClock
            android:id="@+id/data"
            style="@style/TextSobreFons"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:format12Hour="EEEE d MMMM"
            android:format24Hour="EEEE d MMMM"
            android:textSize="20sp" />

        <!-- Espai buit perquè les apps quedin a baix, a l'abast del polze. -->
        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Fila d'apps permeses: 4 caselles iguals, omplertes d'esquerra a dreta. -->
        <LinearLayout
            android:id="@+id/graella_apps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="4">

            <LinearLayout
                android:id="@+id/app_telefon"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingVertical="8dp">

                <ImageView
                    android:layout_width="@dimen/mida_icona_app"
                    android:layout_height="@dimen/mida_icona_app"
                    android:background="@drawable/fons_icona_telefon"
                    android:contentDescription="@null"
                    android:padding="14dp"
                    android:src="@drawable/ic_telefon" />

                <TextView
                    style="@style/TextSobreFons"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/app_telefon"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/app_llanterna"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingVertical="8dp">

                <ImageView
                    android:id="@+id/icona_llanterna"
                    android:layout_width="@dimen/mida_icona_app"
                    android:layout_height="@dimen/mida_icona_app"
                    android:background="@drawable/fons_icona_llanterna"
                    android:contentDescription="@null"
                    android:padding="14dp"
                    android:src="@drawable/ic_llanterna" />

                <TextView
                    style="@style/TextSobreFons"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/app_llanterna"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Només en versions de desenvolupament (ho decideix el codi). -->
        <TextView
            android:id="@+id/text_estat"
            style="@style/TextSobreFons"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:textSize="12sp"
            android:visibility="gone"
            tools:text="@string/estat_propietari_no"
            tools:visibility="visible" />

        <Button
            android:id="@+id/boto_treure_propietari"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="@string/boto_treure_propietari"
            android:textColor="@android:color/white"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
