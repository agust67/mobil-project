<?xml version="1.0" encoding="utf-8"?>
<!-- Una fila de la llista: inicial, nom, i botons de trucar i xat. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="80dp"
    android:orientation="horizontal"
    android:paddingHorizontal="8dp">

    <TextView
        android:id="@+id/inicial_contacte"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:gravity="center"
        android:textColor="@android:color/white"
        android:textSize="22sp"
        android:textStyle="bold"
        tools:background="@drawable/fons_boto_xat"
        tools:text="N" />

    <TextView
        android:id="@+id/nom_contacte"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@android:color/white"
        android:textSize="22sp"
        tools:text="Nom1" />

    <ImageButton
        android:id="@+id/boto_trucar"
        android:layout_width="@dimen/mida_boto_rodo"
        android:layout_height="@dimen/mida_boto_rodo"
        android:background="@drawable/fons_boto_trucar"
        android:padding="12dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_telefon" />

    <ImageButton
        android:id="@+id/boto_xat"
        android:layout_width="@dimen/mida_boto_rodo"
        android:layout_height="@dimen/mida_boto_rodo"
        android:layout_marginStart="12dp"
        android:background="@drawable/fons_boto_xat"
        android:padding="12dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_xat" />
</LinearLayout>
