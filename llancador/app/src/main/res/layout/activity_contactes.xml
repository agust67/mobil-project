<?xml version="1.0" encoding="utf-8"?>
<!-- Pantalla Telèfon: llista de contactes permesos. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/contactes"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fons_llista"
    android:orientation="vertical"
    tools:context=".ContactesActivity">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="8dp"
        android:text="@string/titol_contactes"
        android:textColor="@android:color/white"
        android:textSize="34sp"
        android:textStyle="bold" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Aquí s'afegeix una fila (element_contacte) per a cada contacte. -->
        <LinearLayout
            android:id="@+id/llista_contactes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp" />
    </ScrollView>
</LinearLayout>
